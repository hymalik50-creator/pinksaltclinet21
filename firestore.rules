rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      // This is a basic check - enhance with proper admin verification
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Administrators collection - Admin only
    match /administrators/{adminId} {
      allow read, write: if false; // Managed only through Admin SDK
    }
    
    // Categories collection
    match /categories/{categoryId} {
      // Public read access for published categories
      allow read: if resource.data.isPublished == true;
      
      // Admin full access
      allow read, write: if isAdmin();
    }
    
    // Products collection
    match /products/{productId} {
      // Public read access for published products
      allow read: if resource.data.isPublished == true;
      
      // Admin full access
      allow read, write: if isAdmin();
    }
    
    // Product Images collection
    match /productImages/{imageId} {
      // Public read access
      allow read: if true;
      
      // Admin full access
      allow write: if isAdmin();
    }
    
    // Inquiries collection
    match /inquiries/{inquiryId} {
      // Anyone can create inquiries
      allow create: if request.auth == null || request.auth != null;
      
      // Admin full access
      allow read, update, delete: if isAdmin();
    }
    
    // Contact Messages collection
    match /contactMessages/{messageId} {
      // Anyone can create contact messages
      allow create: if request.auth == null || request.auth != null;
      
      // Admin full access
      allow read, delete: if isAdmin();
    }
  }
}
